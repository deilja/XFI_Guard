# XFI Guard Cluster Master
# Скопировать в /etc/xfi-guard/cluster.env и изменить значения.

# Адрес прослушивания.
# Для Master за приватной AWG/VPN-сетью рекомендуется приватный IP,
# а не 0.0.0.0.
XFI_GUARD_CLUSTER_HOST=127.0.0.1
XFI_GUARD_CLUSTER_PORT=8765

# Обязательный Bearer token для HTTP API.
XFI_GUARD_CLUSTER_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# HMAC secret для подписанных threat events.
XFI_GUARD_CLUSTER_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Persistent cluster state.
XFI_GUARD_CLUSTER_STATE=/var/lib/xfi-guard/cluster-state.json

# URL, который используют Telegram/узлы для обращения к Master.
# Если бот и Master на одном VPS: http://127.0.0.1:8765
# Если бот на другом узле: http://10.70.x.x:8765
XFI_GUARD_CLUSTER_MASTER_URL=http://127.0.0.1:8765

# Таймаут HTTP-клиента.
XFI_GUARD_CLUSTER_TIMEOUT=5
