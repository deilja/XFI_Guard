# XFI Guard Cluster Node
XFI_GUARD_CLUSTER_NODE_NAME=node-01

# Reachable Cluster Master URL.
XFI_GUARD_CLUSTER_MASTER_URL=https://master.example

# Must match Master.
XFI_GUARD_CLUSTER_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
XFI_GUARD_CLUSTER_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# TLS: prefer a trusted CA bundle for a private/self-signed Master.
# XFI_GUARD_CLUSTER_TLS_CA_FILE=/etc/xfi-guard/master-ca.pem
# Emergency/explicit self-signed mode only:
# XFI_GUARD_CLUSTER_TLS_INSECURE=1

# Heartbeat interval in seconds.
XFI_GUARD_CLUSTER_HEARTBEAT_INTERVAL=30

# Local state.
XFI_GUARD_CLUSTER_NODE_STATE=/var/lib/xfi-guard/node-state.json
