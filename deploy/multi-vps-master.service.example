[Unit]
Description=XFI Guard Multi-VPS Master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xfi-guard
EnvironmentFile=-/etc/xfi-guard/cluster.env
ExecStart=/opt/xfi-guard/.venv/bin/python -m xfi_guard.cluster_master
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/xfi-guard /var/log/xfi-guard

[Install]
WantedBy=multi-user.target
