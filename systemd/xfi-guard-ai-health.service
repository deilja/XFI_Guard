[Unit]
Description=XFI Guard AI provider health check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/xfi-guard
ExecStart=/usr/bin/python3 -m xfi_guard.ai_health
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xfi-guard

[Install]
WantedBy=multi-user.target
