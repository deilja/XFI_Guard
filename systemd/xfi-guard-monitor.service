[Unit]
Description=XFI Guard Autonomous Security Monitor
After=network-online.target xfi-guard-bot.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xfi-guard
EnvironmentFile=-/etc/xfi-guard/bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xfi-guard/.venv/bin/python -m xfi_guard.security_monitor
Restart=always
RestartSec=10
NoNewPrivileges=false
PrivateTmp=false
ProtectSystem=off
ProtectHome=false
ReadWritePaths=/var/lib/xfi-guard

[Install]
WantedBy=multi-user.target
