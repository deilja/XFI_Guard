[Unit]
Description=XFI Guard Autonomous Security Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -m xfi_guard.security_monitor
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/xfi-guard

[Install]
WantedBy=multi-user.target
