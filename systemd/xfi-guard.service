[Unit]
Description=XFI Guard VPS Security Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xfi-guard
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xfi-guard/.venv/bin/python -m xfi_guard.daemon --config /opt/xfi-guard/config.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/xfi-guard /var/lib/xfi-guard

[Install]
WantedBy=multi-user.target
