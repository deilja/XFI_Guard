[Unit]
Description=XFI Guard Telegram Administration Bot
After=network-online.target xfi-guard.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xfi-guard
EnvironmentFile=-/etc/xfi-guard/bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xfi-guard/.venv/bin/python -m xfi_guard.bot
Restart=always
RestartSec=5
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/xfi-guard /etc/ufw

[Install]
WantedBy=multi-user.target
