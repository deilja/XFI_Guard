[Unit]
Description=XFI Guard Telegram Administration Bot
After=network-online.target xfi-guard.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xfi-guard
EnvironmentFile=-/etc/xfi-guard/bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xfi-guard/.venv/bin/python -m xfi_guard.bot
Restart=always
RestartSec=5
# The bot performs administrator-approved UFW changes.
# Do not sandbox filesystem access because UFW must write /etc/ufw/user.rules.
PrivateTmp=false
ProtectSystem=off
ProtectHome=false
ReadWritePaths=/etc/ufw /lib/ufw /var/lib/ufw /run/ufw /var/lib/xfi-guard

[Install]
WantedBy=multi-user.target
