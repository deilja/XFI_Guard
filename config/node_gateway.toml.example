# Политика защищённого канала Master ↔ Entry/Exit.
# Управление должно проходить только через приватную AWG-подсеть.

[шлюз]
включён = true
требовать_mtls = true
минимальная_версия_tls = "1.2"

[доверенные_сети]
сети = ["10.70.0.0/16"]

# Формат: node_id=ROLE
# Пример:
# master=MASTER
# entry-01=ENTRY
# exit-01=EXIT

[безопасность]
публичное_управление = false
разрешать_неизвестные_узлы = false
хранить_закрытые_ключи = false

[журнал]
русский_язык = true
секреты_скрывать = true
